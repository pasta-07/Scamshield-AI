# ScamShield AI - Environment Configuration Example
# RAKSHAM AI Cybersecurity Hackathon | IIT Delhi (Problem Statement 2)
# Note: ScamShield AI operates completely offline with zero mandatory API keys.

# Optional custom database path (defaults to data/scamshield.db)
SCAMSHIELD_DB_PATH=data/scamshield.db

# Optional logging level (DEBUG, INFO, WARNING, ERROR)
SCAMSHIELD_LOG_LEVEL=INFO

# Optional environment tag (PROTOTYPE, TEST, PRODUCTION)
SCAMSHIELD_ENV=PROTOTYPE
